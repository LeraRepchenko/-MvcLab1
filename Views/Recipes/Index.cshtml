@model IEnumerable<MvcLab1.Models.Recipe>

@{
    ViewData["Title"] = "Управление рецептами";
}

<h1>Управление рецептами</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить рецепт</a>
</p>

@if (!string.IsNullOrEmpty(ViewBag.Cuisine))
{
    <h4>Рецепты кухни: @ViewBag.Cuisine</h4>
}
@if (!string.IsNullOrEmpty(ViewBag.Difficulty))
{
    <h4>Рецепты сложности: @ViewBag.Difficulty</h4>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Cuisine)</th>
            <th>@Html.DisplayNameFor(model => model.Difficulty)</th>
            <th>@Html.DisplayNameFor(model => model.PrepTime)</th>
            <th>@Html.DisplayNameFor(model => model.CookTime)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Cuisine</td>
                <td>@item.Difficulty</td>
                <td>@item.PrepTime мин</td>
                <td>@item.CookTime мин</td>
                <td>@item.CreatedDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
