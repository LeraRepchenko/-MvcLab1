@{
    ViewData["Title"] = "Блюдо не найдено";
}

<div class="error-container text-center">
    <h1 class="display-1">404</h1>
    <h2>@ViewBag.ErrorMessage</h2>

    <div class="error-image">
        🍽️❓
    </div>

    <p class="lead">К сожалению, мы не можем найти такое блюдо в нашем меню.</p>

    <div class="suggestions">
        <h3>Возможно, вас заинтересуют:</h3>
        <div class="suggested-links">
            @foreach (var id in ViewBag.SuggestedIds)
            {
                <a href="/restaurant/dish/@id" class="btn btn-outline-primary">Блюдо #@id</a>
            }
        </div>
    </div>

    <hr />

    <div class="navigation-links">
        <a href="/restaurant" class="btn btn-secondary">На главную ресторана</a>
        <a href="/restaurant/menu" class="btn btn-primary">Посмотреть меню</a>
        <a href="/restaurant/booking" class="btn btn-success">Забронировать столик</a>
    </div>
</div>

<style>
    .error-container {
        padding: 50px 20px;
        max-width: 800px;
        margin: 0 auto;
    }

    .display-1 {
        font-size: 8em;
        font-weight: bold;
        color: #dc3545;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .error-image {
        font-size: 10em;
        margin: 30px 0;
        opacity: 0.5;
    }

    .suggestions {
        margin: 40px 0;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 10px;
    }

    .suggested-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-top: 20px;
    }

    .navigation-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-top: 30px;
    }

    @@media (max-width: 768px) {
        .display-1 {
            font-size: 5em;
        }

        .error-image {
            font-size: 6em;
        }

        .suggested-links, .navigation-links {
            flex-direction: column;
        }

        .suggested-links .btn, .navigation-links .btn {
            width: 100%;
        }
    }
</style>