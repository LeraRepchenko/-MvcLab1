@{
    ViewData["Title"] = ViewData["PageTitle"];
}

<div class="confirmation-container">
    <div class="success-card card">
        <div class="card-header bg-success text-white">
            <h1>✓ Бронирование подтверждено!</h1>
        </div>
        <div class="card-body">
            <div class="booking-details">
                <h3>Детали бронирования</h3>

                <div class="detail-row">
                    <span class="detail-label">Номер брони:</span>
                    <span class="detail-value booking-number">#@ViewBag.BookingNumber</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Имя:</span>
                    <span class="detail-value">@ViewBag.Name</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Телефон:</span>
                    <span class="detail-value">@ViewBag.Phone</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Количество гостей:</span>
                    <span class="detail-value">@ViewBag.Guests</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Дата:</span>
                    <span class="detail-value">@ViewBag.Date</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Время:</span>
                    <span class="detail-value">@ViewBag.Time</span>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Comments))
                {
                    <div class="detail-row">
                        <span class="detail-label">Комментарий:</span>
                        <span class="detail-value">@ViewBag.Comments</span>
                    </div>
                }
            </div>

            <hr />

            <div class="alert alert-success">
                <strong>Спасибо за бронирование!</strong> Мы ждем вас в нашем ресторане.
                <br />
                <small>Если у вас возникли вопросы, позвоните нам по телефону @ViewData["Phone"]</small>
            </div>

            <div class="confirmation-actions">
                <button class="btn btn-primary" onclick="window.print()">🖨️ Распечатать подтверждение</button>
                <a href="/restaurant" class="btn btn-secondary">← На главную</a>
                <a href="/restaurant/menu" class="btn btn-info">Посмотреть меню</a>
            </div>
        </div>
    </div>
</div>

<style>
    .confirmation-container {
        max-width: 800px;
        margin: 30px auto;
    }

    .success-card {
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        border: none;
    }

    .card-header.bg-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%) !important;
    }

    .booking-details {
        margin: 20px 0;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 5px;
    }

    .detail-row {
        display: flex;
        padding: 10px 0;
        border-bottom: 1px solid #dee2e6;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        flex: 0 0 150px;
        font-weight: bold;
        color: #666;
    }

    .detail-value {
        flex: 1;
    }

    .booking-number {
        font-family: monospace;
        font-size: 1.2em;
        font-weight: bold;
        color: #28a745;
    }

    .confirmation-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 20px;
    }

    @@media print {
        .confirmation-actions, .btn {
            display: none;
        }

        .success-card {
            box-shadow: none;
            border: 1px solid #ddd;
        }
    }

    @@media (max-width: 768px) {
        .detail-row {
            flex-direction: column;
        }

        .detail-label {
            flex: none;
            margin-bottom: 5px;
        }

        .confirmation-actions {
            flex-direction: column;
        }

        .confirmation-actions .btn {
            width: 100%;
        }
    }
</style>